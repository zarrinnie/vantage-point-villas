{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/vantage-point-villas/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/vantage-point-villas/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
